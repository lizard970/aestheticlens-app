# Backend process: mock (default) or chat_completions.
# Load with: cd backend; python -m uvicorn app.main:app --env-file ../.env --port 8000
AESTHETICLENS_PROVIDER=mock
AESTHETICLENS_BASE_URL=
AESTHETICLENS_MODEL=
AESTHETICLENS_API_KEY=
AESTHETICLENS_TIMEOUT_SECONDS=45
AESTHETICLENS_MAX_RETRIES=1
AESTHETICLENS_RETRY_DELAY_SECONDS=0.5
AESTHETICLENS_MAX_COMPLETION_TOKENS=3000
NEXT_PUBLIC_AESTHETICLENS_API_URL=http://localhost:8000/api/v1
# PostgreSQL is optional for local tests; set it for durable API storage.
AESTHETICLENS_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/aestheticlens
# External embeddings (OpenAI); credentials stay in local environment only.
AESTHETICLENS_EMBEDDING_PROVIDER=
AESTHETICLENS_EMBEDDING_BASE_URL=https://api.openai.com/v1
AESTHETICLENS_EMBEDDING_MODEL=text-embedding-3-small
AESTHETICLENS_EMBEDDING_API_KEY=
AESTHETICLENS_EMBEDDING_TIMEOUT_SECONDS=30
# Operational cosine cutoff for knowledge answers; calibrate against your cases.
AESTHETICLENS_ANSWER_MIN_SIMILARITY=0.3
